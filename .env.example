# Supabase Configuration
# URL of your Supabase project
SUPABASE_URL=https://your-project-ref.supabase.co
# Anon key — not used by the backend, kept for reference / scripts only
SUPABASE_KEY=your-anon-key-here
# Service role key — REQUIRED. The backend uses this to bypass RLS and
# enforces clinic isolation itself via per-query clinic_id filters.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT Configuration
# REQUIRED. Set to a strong random value (e.g. `openssl rand -hex 32`).
# The backend refuses to start if this equals the default below.
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME=Vet Clinic VMS

# CORS — comma-separated list of frontend origins allowed to call this API.
# Include every dev and production host the browser app may be served from.
FRONTEND_ORIGINS=http://localhost:8080,http://localhost:5173
